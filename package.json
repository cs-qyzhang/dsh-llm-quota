{
  "name": "@cs-qyzhang/dsh-llm-quota",
  "version": "1.2.0",
  "type": "module",
  "description": "Shows the active model provider's remaining balance or coding-plan quota in DeepSeek Harness (dsh).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "quota",
    "balance",
    "coding-plan"
  ],
  "homepage": "https://github.com/cs-qyzhang/dsh-llm-quota#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cs-qyzhang/dsh-llm-quota.git"
  },
  "bugs": {
    "url": "https://github.com/cs-qyzhang/dsh-llm-quota/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check history.js && node --check provider.js && node --check client.js && node -e \"const{readdirSync}=require('node:fs');const{execFileSync}=require('node:child_process');for(const f of readdirSync('providers'))execFileSync(process.execPath,['--check','providers/'+f],{stdio:'inherit'})\"",
    "test": "node --test test/host.test.js test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.2 || >=0.2.2-0 <0.2.3",
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./provider": "./provider.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "history.js",
    "client.js",
    "provider.js",
    "providers/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
