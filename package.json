{
  "name": "@cs-qyzhang/dsh-llm-quota",
  "version": "1.1.0",
  "type": "module",
  "description": "Shows the active model provider's remaining balance or coding-plan quota below the composer.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "quota",
    "balance",
    "coding-plan"
  ],
  "homepage": "https://github.com/cs-qyzhang/dsh-llm-quota#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cs-qyzhang/dsh-llm-quota.git"
  },
  "bugs": {
    "url": "https://github.com/cs-qyzhang/dsh-llm-quota/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node -e \"const{readdirSync}=require('node:fs');const{execFileSync}=require('node:child_process');for(const f of readdirSync('providers'))execFileSync(process.execPath,['--check','providers/'+f],{stdio:'inherit'})\"",
    "test": "node --test test/host.test.js test/*.test.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "providers/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
